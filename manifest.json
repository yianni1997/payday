{
 "name": "Payday",
 "short_name": "Payday",
 "description": "Paycheck budget and expense tracker",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#F2F3EF",
 "theme_color": "#FFE600",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "file",
     "accept": [
      ".zip",
      "application/zip",
      "application/x-zip-compressed",
      "application/octet-stream",
      "*/*"
     ]
    }
   ]
  }
 },
 "shortcuts": [
  {
   "name": "Review",
   "short_name": "Review",
   "url": "./?go=review",
   "icons": [
    {
     "src": "icon-192.png",
     "sizes": "192x192",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Add a charge",
   "short_name": "Add",
   "url": "./?go=add",
   "icons": [
    {
     "src": "icon-192.png",
     "sizes": "192x192",
     "type": "image/png"
    }
   ]
  },
  {
   "name": "Pull from bank",
   "short_name": "Pull",
   "url": "./?go=pull",
   "icons": [
    {
     "src": "icon-192.png",
     "sizes": "192x192",
     "type": "image/png"
    }
   ]
  }
 ]
}